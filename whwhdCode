import time
import cv2
import numpy as np
import keyboard
import serial, time

bluetooth_port = 'COM5'

car= serial.Serial(bluetooth_port, 9600)
time.sleep(2)
4 

# --- 함수 정의 영역 ---
def act_w():
    print("[실행] W 함수 (앞)")
    car.write(b"go\n") 

def act_a():
    print("[실행] A 함수 (왼쪽)")
    car.write(b"left\n") 

def act_s():
    print("[실행] S 함수 (뒤)")
    car.write(b"back\n") 

def act_d():
    print("[실행] D 함수 a(오른쪽)")
    car.write(b"right\n") 

def act_none():
    print("[없음]")
    car.write(b"stop\n")

# 우선순위 순서: 오른쪽(d) -> 왼쪽(a) -> 앞(w) -> 뒤(s)
priority_order = ['d', 'a', 'w', 's']

# OpenCV 창 설정
window_name = "WASD Priority Visualizer (Press 'q' to quit)"
cv2.namedWindow(window_name, cv2.WINDOW_AUTOSIZE)

print("프로그램이 시작되었습니다. 매 프레임마다 상태에 맞는 함수가 실행됩니다.")

try:
    while True:
        # 1. 우선순위 순서대로 현재 눌려 있는 키 검사
        current_active_key = None
        for key in priority_order:
            if keyboard.is_pressed(key):
                current_active_key = key
                break  # 가장 높은 우선순위 키를 찾으면 탐색 중단
        
        # 2. [매 프레임 실행] 현재 상태에 맞는 함수를 매 반복마다 호출
        if current_active_key == 'd':
            act_d()
        elif current_active_key == 'a':
            act_a()
        elif current_active_key == 'w':
            act_w()
        elif current_active_key == 's':
            act_s()
        else:
            act_none()

        # --- OpenCV 시각화 영역 ---
        img = np.zeros((260, 400, 3), dtype=np.uint8)
        
        # 안내 텍스트 표시
        cv2.putText(img, "Priority: D > A > W > S", (20, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (200, 200, 200), 1)
        cv2.putText(img, "Press 'q' to Exit", (20, 55), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (200, 200, 200), 1)

        # W, A, S, D UI 좌표 설정
        keys_layout = {
            'w': ((170, 80), (230, 140), "W (앞)", (178, 118)),
            'a': ((100, 150), (160, 210), "A (왼)", (112, 188)),
            's': ((170, 150), (230, 210), "S (뒤)", (182, 188)),
            'd': ((240, 150), (300, 210), "D (오)", (248, 188))
        }

        for k, (start, end, label, text_pos) in keys_layout.items():
            color = (0, 255, 0) if k == current_active_key else (70, 70, 70)
            cv2.rectangle(img, start, end, color, -1)
            cv2.rectangle(img, start, end, (200, 200, 200), 2)
            cv2.putText(img, label, text_pos, cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)

        cv2.imshow(window_name, img)

        # 'q'를 누르면 종료 (cv2.waitKey(30)에 의해 초당 약 30프레임으로 실행됨)
        if cv2.waitKey(30) & 0xFF == ord('q'):
            break

finally:
    cv2.destroyAllWindows()
    car.close()
    print("프로그램이 정상 종료되었습니다.")
